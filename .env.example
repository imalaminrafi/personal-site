# Cloudinary (safe to expose in the frontend — public values only)
# Required for browser uploads via the shared CloudinaryUploader service.
VITE_CLOUDINARY_CLOUD_NAME=iznm1bbp
VITE_CLOUDINARY_UPLOAD_PRESET=alaminrafi_upload

# Optional: endpoint of the serverless delete function (/api/cloudinary-delete.mjs)
# This keeps the API secret on the server. Without it, deletes only remove
# the local library entry (the asset stays on Cloudinary).
VITE_CLOUDINARY_DELETE_URL=

# Server-side only (used by the delete function). NEVER prefix with VITE_.
CLOUDINARY_CLOUD_NAME=iznm1bbp
CLOUDINARY_API_KEY=326537536959165
CLOUDINARY_API_SECRET=Uc1tJ3ljYVcl-Sw-pM6d0Hnzubw
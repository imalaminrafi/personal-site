# Cloudinary (safe to expose in the frontend — public values only)
# These are REQUIRED for uploads to work. Replace the placeholders with the
# real values from your Cloudinary dashboard (console.cloudinary.com).
#
#   VITE_CLOUDINARY_CLOUD_NAME: top-left of the dashboard, e.g. "my_cloud"
#   VITE_CLOUDINARY_UPLOAD_PRESET: an UNSIGNED preset created in
#       Settings > Upload > Upload presets > Signing mode: Unsigned
#
# The preset is never hardcoded in the app; it must come from this env var.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# Optional: endpoint of the serverless delete function (/api/cloudinary-delete.mjs)
# This keeps the API secret on the server. Without it, deletes only remove
# the local library entry (the asset stays on Cloudinary).
VITE_CLOUDINARY_DELETE_URL=

# Server-side only (used by the delete function). NEVER prefix with VITE_.
# Replace with real credentials from the dashboard (Settings > Access Keys).
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
